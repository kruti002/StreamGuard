# Copy to `.env` and fill in from Confluent Cloud.
# The dashboard only needs the KAFKA credentials (not Schema Registry).

BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-2.aws.confluent.cloud:9092
CONFLUENT_API_KEY=YOUR_KAFKA_API_KEY
CONFLUENT_API_SECRET=YOUR_KAFKA_API_SECRET

# SELF_COMPUTE=true (default): the dashboard reads raw_events and computes the
# contract, per-source error rates, forecast, and DLQ itself — no dependency on
# the Flink dq_alerts materialized table. Set to false to instead read the
# Flink output topics (dq_alerts + quarantine_events).
SELF_COMPUTE=true
RAW_TOPIC=raw_events
ALERTS_TOPIC=dq_alerts
QUARANTINE_TOPIC=quarantine_events

# Web server + consumer group
PORT=3000
GROUP_ID=streamguard-dashboard
